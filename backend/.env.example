# MeetFlow AI Backend Environment Configuration
PORT=10000
FRONTEND_URL=http://localhost:5173

# Firebase Configuration (matches VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=

# Application Session Secret for JWT signing
JWT_SECRET=meetflow-jwt-super-secret-key-change-in-production-2026

# Optional: Google Gemini API Key for live AI extraction
# When omitted, MeetFlow AI automatically uses the intelligent Grounded Local Extractor engine
GEMINI_API_KEY=

# Optional: Database URL (for future persistent DB adapter)
DATABASE_URL=
